# Copy to .env for local-only credentials. Do not commit .env.

# AWS profile/region for optional hack demo resources.
AWS_PROFILE=
AWS_REGION=us-west-2

# Convoke Bio MCP auth. Complete sign-in at:
# https://platform.convoke.bio/sign-in?redirect_url=https%3A%2F%2Fplatform.convoke.bio%2F
CONVOKE_MCP_TOKEN=

# Optional retrieval providers. Use only when terms allow hackathon use.
BRIGHTDATA_API_KEY=
BRIGHT_DATA_API_KEY=
BRIGHTDATA_TOKEN=
BRIGHT_DATA_TOKEN=
BRIGHTDATA_GROUPS=code

# Optional LLM support. Do not use for unsupported scientific claim promotion.
OPENAI_API_KEY=
